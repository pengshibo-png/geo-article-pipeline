# GEO 内容营销 SaaS · 环境变量样例
# 复制为 .env 后按需修改。生产环境必须显式设置 GEO_SECRET_KEY。

# ── 基础 ──────────────────────────────────────────────────────────────
GEO_ENV=dev
# dev | test | prod   （prod 会强制校验 SECRET_KEY，且必须换掉默认值）
GEO_SECRET_KEY=dev-insecure-change-me
# ADR-013：全系统时间基准 —— 只能填 Asia/Shanghai，填错直接启动失败
GEO_TIMEZONE=Asia/Shanghai

# ── 数据库 ────────────────────────────────────────────────────────────
# 开发：SQLite（注意：SQLite 不支持 RLS，隔离验收必须在 PostgreSQL 上跑 V5）
GEO_DATABASE_URL=sqlite:///./data/app.db
# 生产：
# GEO_DATABASE_URL=postgresql+psycopg://geo:pwd@127.0.0.1:5432/geo

# ── 日志（ADR-010）────────────────────────────────────────────────────
GEO_LOG_LEVEL=INFO
GEO_LOG_JSON=1

# ── 队列（ADR-004 阶段一：进程内线程池）──────────────────────────────
GEO_JOB_BACKEND=threadpool
GEO_GEN_POOL_SIZE=4

# ── LLM 多 Key 池（AI-ARCH-002）──────────────────────────────────────
# fake = 离线确定性假供应商（无需 Key，用于本地跑通与测试）
GEO_LLM_PROVIDER=fake
# 可选：fake | deepseek | doubao | qwen | openai-compat
GEO_LLM_KEYS=
# 多个 Key 用逗号分隔：sk-aaa,sk-bbb,sk-ccc（撞限流自动换 Key + 冷却复活）
GEO_LLM_MAX_RETRIES=3
GEO_LLM_COOLDOWN_SECONDS=60

# ── 发布渠道驱动（真实浏览器 = Playwright）────────────────────────────
# auto（默认）：账号在「账号授权」里配了 Cookie 且平台有适配器 → 真实浏览器发布；
#              没配 Cookie → 离线模拟（任务日志会写明"不会真的发出去"）
# fake：一律离线假驱动（演示/测试）
GEO_PUBLISH_DRIVER=auto
# 真实发布时是否无头运行（调试选择器时设 0，能看见浏览器窗口）
GEO_PUBLISH_HEADLESS=1
# 单步超时（毫秒）
GEO_PUBLISH_TIMEOUT_MS=30000
